# Supabase project (Settings -> API). Leave empty to run in demo mode with sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL, used in sign-in links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: AI tone check for replies to reviews (server only, never NEXT_PUBLIC)
ANTHROPIC_API_KEY=
